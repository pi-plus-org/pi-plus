// Type check for the p2-side wrappers (src/p2/) and their tests. These files re-export upstream apps/p2
// modules, so they are checked in p2's compiler context (apps/p2/tsconfig.json's settings) instead of the
// root check: the root program runs with declaration emit on, and pulled-in upstream p2 files fail its
// portability analysis (TS2883 in apps/p2/src/runtime/tui-preferences.ts and elsewhere). The root
// tsconfig.json excludes this directory and test/p2-wrappers.test.ts for the same reason; declaration
// is disabled here since this config type-checks the wrappers, it does not emit declarations.
//
// paths is copied from apps/p2/tsconfig.json rather than inherited: TS resolves inherited paths relative
// to the extending config, which would miss from this directory and fall back to node_modules (chord's
// dist d.ts). The "../.."-relative entries are identical in both locations; the "./"-relative
// @p2/app/v1 entries are re-anchored to apps/p2 explicitly.
{
	"extends": "../../apps/p2/tsconfig.json",
	"include": [
		"src/p2/**/*.ts",
		"test/p2-wrappers.test.ts"
	],
	"exclude": [
		"**/dist/**"
	],
	"compilerOptions": {
		"declaration": false,
		"declarationMap": false,
		"paths": {
			"@p2/app/v1": [
				"../../apps/p2/src/api/v1/index.ts"
			],
			"@p2/app/v1/*": [
				"../../apps/p2/src/api/v1/*.ts"
			],
			"@earendil-works/chord": [
				"../../packages/chord/src/index.ts"
			],
